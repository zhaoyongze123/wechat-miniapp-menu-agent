# 把副本保存为 .env。管理员口令仅保存在本机。
MENU_CAPTURE_ADMIN_PASSWORD=
# 额外允许的访问地址，填 A 机的 Tailscale IPv4 或内网域名，不带协议和端口，多个用逗号分隔。
MENU_CAPTURE_ALLOWED_HOSTS=
# Tailscale 转发到此回环端口。并行演练时可改用其他端口。
MENU_CAPTURE_HOST_PORT=8766
# 发布版本与镜像标签；升级/回滚时改这两个值，数据卷保持不变。
MENU_CAPTURE_VERSION=0.1.0
MENU_CAPTURE_IMAGE=menu-capture-hub:0.1.0
# 合格成品目录的宿主机挂载根；服务在其下按 项目/<code>/合格 生成每个项目的交付目录。
# Windows Docker Desktop 示例：MENU_CAPTURE_DELIVERY_MOUNT=D:/MenuCapture
# 留空使用 compose 同级的 ./delivery，首次启动会自动初始化全部历史合格门店。
MENU_CAPTURE_DELIVERY_MOUNT=
# 交付目录同步轮询间隔（秒），默认 5。
MENU_CAPTURE_DELIVERY_POLL_SECONDS=5
