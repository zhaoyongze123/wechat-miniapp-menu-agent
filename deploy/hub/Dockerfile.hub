# A 机仅保存业务数据和提供 API，桌面采集在登录用户的 Windows 会话运行。
FROM ghcr.io/astral-sh/uv:0.11.3 AS uv
FROM python:3.12.16-slim-bookworm AS dependencies

COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /opt/menu-capture
ENV UV_PROJECT_ENVIRONMENT=/opt/menu-venv UV_NO_MANAGED_PYTHON=1 UV_LINK_MODE=copy
COPY app/pyproject.toml app/uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

FROM python:3.12.16-slim-bookworm

# 发布版本：镜像构建时写入，供 /api/version 核对实际运行的前后端版本。
ARG VERSION=0.1.0
LABEL org.opencontainers.image.title="menu-capture-hub" \
      org.opencontainers.image.version="$VERSION" \
      org.opencontainers.image.description="菜单采集共享后台（含 React 控制台静态产物）"

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 menu-capture \
    && useradd --uid 10001 --gid 10001 --no-create-home menu-capture \
    && install -d -o 10001 -g 10001 /var/lib/menu-capture \
    && install -d -o 10001 -g 10001 /var/lib/menu-delivery
ENV PATH="/opt/menu-venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    MENU_CAPTURE_VERSION=$VERSION \
    MENU_CAPTURE_ROLE=hub MENU_CAPTURE_HOME=/var/lib/menu-capture MENU_CAPTURE_BIND=0.0.0.0 MENU_CAPTURE_PORT=8765
WORKDIR /opt/menu-capture
COPY --from=dependencies /opt/menu-venv /opt/menu-venv
COPY app/menu_capture ./menu_capture
COPY app/web ./web
# 镜像必须自带完整前端产物，运行时不依赖 Node、npm 或外部 CDN。
RUN test -s web/react/index.html && test -s web/react/.vite/manifest.json
USER 10001:10001
EXPOSE 8765
CMD ["python", "-m", "menu_capture.api.server"]
