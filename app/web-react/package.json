{
  "name": "menu-capture-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint:code": "eslint src",
    "lint:design": "node scripts/check-design-system.mjs",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "generate:api-types": "openapi-typescript ../openapi.json -o src/api/generated.d.ts",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@openai/apps-sdk-ui": "0.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.87.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
